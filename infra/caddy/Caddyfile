{
	admin off
	auto_https off

	# Privacy (ADR 0002): no access log is written, deliberately. The site block
	# has no `log` directive, and access logs would hold every client address.
	# Caddy's own error log also records the request, address included, so it is
	# filtered: the address, port and all request headers are deleted from it.
	log {
		format filter {
			wrap json
			fields {
				request>remote_ip delete
				request>remote_port delete
				request>client_ip delete
				request>headers delete
			}
		}
	}
}

import /etc/caddy/compress.caddy

:80 {
	handle /caddy-health {
		respond "ok" 200
	}

	import /etc/caddy/media.caddy

	handle /api/* {
		# The API sets its own Cache-Control and ETag; Caddy only compresses.
		import compress
		reverse_proxy api:8000 {
			# The API takes the client address from this header (only to hash
			# it, never to store it). Set it, do not append to it: whatever the
			# client sent is replaced by the address Caddy saw, so it cannot be
			# forged. The API port is not published, so Caddy is the only way in.
			header_up X-Forwarded-For {remote_host}
			header_up -Forwarded
			header_up -X-Real-Ip
			# encode appends -gzip or -zstd to an ETag it compresses, so a browser
			# revalidates with a tag the API never issued. Give the API back its own.
			header_up If-None-Match "-(?:gzip|zstd)(\"|$)" "$1"
		}
	}

	# Vite names everything in /assets/ after a hash of its content (scripts,
	# styles, fonts), so a URL never changes meaning and is kept for a year. A
	# missing file is a plain 404, never the HTML page, and a 404 is not cached.
	handle /assets/* {
		import compress
		root * /srv
		# Only a file that exists gets the header; a miss is not cached for a year.
		@exists file {path}
		header @exists Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# The HTML document and anything not named by hash (the favicon). The browser
	# may keep a copy but must revalidate it, which file_server answers with a 304
	# from the file's ETag, so a new deployment reaches returning Visitors at once.
	handle {
		import compress
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
