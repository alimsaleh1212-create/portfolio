            "mode": "fixed",
            "fixedColor": "#3987e5"
          },
          "unit": "short",
          "decimals": 0,
          "noValue": "No data in this time range",
          "custom": {
            "axisLabel": "Times opened",
            "axisPlacement": "auto",
            "fillOpacity": 100,
            "lineWidth": 0,
            "gradientMode": "none",
            "axisSoftMin": 0
          }
        },
        "overrides": []
