    {
      "id": 12,
      "type": "table",
      "title": "Contact messages",
      "description": "Messages Visitors sent, newest first, in the selected range. Personal details: this dashboard is private.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT created_at AS \"Received\", name AS \"Name\", email AS \"Address\", message AS \"Message\"\nFROM contact_messages WHERE $__timeFilter(created_at)\nORDER BY created_at DESC LIMIT 200",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 10
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "No contact messages in this time range",
          "custom": {
            "align": "left",
            "cellOptions": {
              "type": "auto",
              "wrapText": true
            },
            "filterable": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Received"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              },
              {
                "id": "custom.width",
                "value": 180
              }
            ]
          },
          {
            "matcher": {
