          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS \"Contact messages sent\" FROM contact_messages WHERE $__timeFilter(created_at)",
          "refId": "A"
        }
