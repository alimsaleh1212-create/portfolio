    {
      "id": 10,
      "type": "barchart",
      "title": "Tiers served",
      "description": "The tier the Climb was served in: full, light or still. (unknown) when the Visit did not report one.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
