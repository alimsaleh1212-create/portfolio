      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS \"Projects opened\" FROM visit_events WHERE type = 'project_opened' AND $__timeFilter(created_at)",
          "refId": "A"
        }
