    {
      "id": 5,
      "type": "timeseries",
      "title": "Visits per day",
      "description": "Visits that started on each UTC day of the selected range.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT d AS time, count(v.id) AS \"Visits\"\nFROM generate_series(\n  date_trunc('day', $__timeFrom()::timestamptz AT TIME ZONE 'UTC'),\n  date_trunc('day', $__timeTo()::timestamptz AT TIME ZONE 'UTC'),\n  interval '1 day') AS d\nLEFT JOIN visits v\n  ON date_trunc('day', v.started_at AT TIME ZONE 'UTC') = d\n AND $__timeFilter(v.started_at)\nGROUP BY d ORDER BY d",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#3987e5"
          },
          "unit": "short",
          "decimals": 0,
          "noValue": "No Visits in this time range",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 90,
            "lineWidth": 1,
            "barAlignment": 0,
            "axisLabel": "Visits per day",
            "axisSoftMin": 0,
            "axisSoftMax": 3,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none"
            },
            "gradientMode": "none"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Unique Visitors per day",
      "description": "Distinct daily Visitor hashes per UTC day. The hash changes every day, so a returning Visitor counts once on each day and no figure across days is shown. A Visit with no hash (Redis was down) is not counted.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT d AS time, count(DISTINCT v.visitor_hash) AS \"Unique Visitors\"\nFROM generate_series(\n  date_trunc('day', $__timeFrom()::timestamptz AT TIME ZONE 'UTC'),\n  date_trunc('day', $__timeTo()::timestamptz AT TIME ZONE 'UTC'),\n  interval '1 day') AS d\nLEFT JOIN visits v\n  ON date_trunc('day', v.started_at AT TIME ZONE 'UTC') = d\n AND $__timeFilter(v.started_at)\nGROUP BY d ORDER BY d",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#3987e5"
          },
          "unit": "short",
          "decimals": 0,
          "noValue": "No Visitors in this time range",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 90,
            "lineWidth": 1,
            "barAlignment": 0,
            "axisLabel": "Unique Visitors per day",
            "axisSoftMin": 0,
            "axisSoftMax": 3,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none"
            },
            "gradientMode": "none"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
    {
      "id": 7,
      "type": "barchart",
      "title": "Visits per Stage (Progress funnel)",
      "description": "For each Stage in Climb order, the Visits whose Progress is that Stage or a higher one. Same logic as the visits_per_stage view, restricted to the selected time range.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT s.name AS \"Stage\", count(p.visit_id) AS \"Visits\"\nFROM stages s\nLEFT JOIN visit_progress p\n  ON p.progress_stage_position >= s.position AND $__timeFilter(p.started_at)\nGROUP BY s.position, s.name\nORDER BY s.position",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#3987e5"
          },
          "unit": "short",
          "decimals": 0,
          "noValue": "No data in this time range",
          "custom": {
            "axisLabel": "Visits that reached the Stage",
            "axisPlacement": "auto",
            "fillOpacity": 100,
            "lineWidth": 0,
            "gradientMode": "none",
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "xField": "Stage",
        "showValue": "always",
        "barWidth": 0.7,
        "groupWidth": 0.8,
        "stacking": "none",
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        },
        "xTickLabelRotation": 0,
        "fullHighlight": false
      }
    },
    {
      "id": 8,
      "type": "barchart",
      "title": "Referring sites",
      "description": "Host of the referring site, top 10. Visits with no referrer are (direct).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(referrer_host, '(direct)') AS \"Referring site\", count(*) AS \"Visits\"\nFROM visits WHERE $__timeFilter(started_at)\nGROUP BY 1 ORDER BY 2 DESC, 1 LIMIT 10",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 12,
