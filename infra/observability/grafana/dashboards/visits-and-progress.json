    {
      "id": 11,
      "type": "barchart",
      "title": "Projects opened by Project",
      "description": "Every Project, most opened first, so a Project nobody opened shows as zero.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT p.name AS \"Project\", count(e.id) AS \"Opened\"\nFROM projects p\nLEFT JOIN visit_events e\n  ON e.project_slug = p.slug AND e.type = 'project_opened' AND $__timeFilter(e.created_at)\nGROUP BY p.position, p.name\nORDER BY 2 DESC, p.position",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 16,
        "y": 21,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
