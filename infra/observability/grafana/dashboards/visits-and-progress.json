          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(tier, '(unknown)') AS \"Tier\", count(*) AS \"Visits\"\nFROM visits WHERE $__timeFilter(started_at)\nGROUP BY 1 ORDER BY 2 DESC, 1",
