{
  "uid": "app-health",
  "title": "Application health",
  "description": "Request rate, errors, latency, cache and database connections of the API, with recent error logs.",
  "tags": [
    "portfolio"
  ],
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "timezone": "utc",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "templating": {
    "list": [
      {
        "name": "route",
        "label": "Route",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(portfolio_http_requests_total, route)",
          "refId": "route"
        },
        "definition": "label_values(portfolio_http_requests_total, route)",
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1,
        "allValue": ".*"
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Requests per second",
      "description": "All requests to the selected routes, averaged over the last 5 minutes. The container health check is left out.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(portfolio_http_requests_total{route=~\"$route\", route!=\"/api/v1/health/live\"}[5m]))",
          "legendFormat": "",
          "refId": "A",
          "format": "time_series",
          "instant": true,
          "range": false
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#3987e5"
          },
          "unit": "reqps",
          "noValue": "No requests"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "justifyMode": "auto"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Error rate",
      "description": "Share of requests answered with a 5xx status over the last 5 minutes.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(portfolio_http_requests_total{route=~\"$route\", route!=\"/api/v1/health/live\", status=~\"5..\"}[5m])) / sum(rate(portfolio_http_requests_total{route=~\"$route\", route!=\"/api/v1/health/live\"}[5m]))",
          "legendFormat": "",
          "refId": "A",
          "format": "time_series",
          "instant": true,
          "range": false
        }
      ],
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "percentunit",
          "noValue": "No requests",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#3987e5",
                "value": null
              },
              {
                "color": "#e66767",
                "value": 0.01
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "justifyMode": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Latency p95",
      "description": "95th percentile of response time over the last 5 minutes, all selected routes.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(portfolio_http_request_duration_seconds_bucket{route=~\"$route\", route!=\"/api/v1/health/live\"}[5m])))",
          "legendFormat": "",
          "refId": "A",
          "format": "time_series",
          "instant": true,
          "range": false
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#3987e5"
          },
          "unit": "s",
          "noValue": "No requests"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "justifyMode": "auto"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Cache hit rate",
      "description": "Share of cached reads (profile, stages, projects, project, media) served from Redis over the last 5 minutes.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(portfolio_cache_hits_total[5m])) / (sum(rate(portfolio_cache_hits_total[5m])) + sum(rate(portfolio_cache_misses_total[5m])))",
          "legendFormat": "",
          "refId": "A",
          "format": "time_series",
          "instant": true,
          "range": false
        }
      ],
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#3987e5"
          },
          "unit": "percentunit",
          "noValue": "No cached reads yet"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "justifyMode": "auto"
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Request rate by route",
      "description": "Requests per second, by route template. The container health check is left out.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (route) (rate(portfolio_http_requests_total{route=~\"$route\", route!=\"/api/v1/health/live\"}[$__rate_interval]))",
          "legendFormat": "{{route}}",
          "refId": "A",
          "format": "time_series"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "reqps",
          "noValue": "No requests in this time range",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "auto",
            "axisLabel": "Requests per second",
            "axisSoftMin": 0,
            "stacking": {
              "mode": "none"
            },
            "spanNulls": false,
            "gradientMode": "none"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Error rate",
      "description": "Share of requests answered 5xx (server errors, red) and 4xx (client errors, gray).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(portfolio_http_requests_total{route=~\"$route\", route!=\"/api/v1/health/live\", status=~\"5..\"}[$__rate_interval])) / sum(rate(portfolio_http_requests_total{route=~\"$route\", route!=\"/api/v1/health/live\"}[$__rate_interval]))",
          "legendFormat": "5xx server errors",
          "refId": "A",
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(portfolio_http_requests_total{route=~\"$route\", route!=\"/api/v1/health/live\", status=~\"4..\"}[$__rate_interval])) / sum(rate(portfolio_http_requests_total{route=~\"$route\", route!=\"/api/v1/health/live\"}[$__rate_interval]))",
          "legendFormat": "4xx client errors",
          "refId": "B",
          "format": "time_series"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "percentunit",
          "noValue": "No requests in this time range",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "auto",
            "axisLabel": "Share of requests",
            "axisSoftMin": 0,
            "stacking": {
              "mode": "none"
            },
            "spanNulls": false,
            "gradientMode": "none",
            "axisSoftMax": 0.05
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "5xx server errors"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#e66767"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "4xx client errors"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#8b8a82"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Latency p95 by route",
      "description": "95th percentile response time per route.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(portfolio_http_request_duration_seconds_bucket{route=~\"$route\", route!=\"/api/v1/health/live\"}[$__rate_interval])))",
          "legendFormat": "{{route}}",
          "refId": "A",
          "format": "time_series"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "s",
          "noValue": "No requests in this time range",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "auto",
            "axisLabel": "Response time (p95)",
            "axisSoftMin": 0,
            "stacking": {
              "mode": "none"
            },
            "spanNulls": false,
            "gradientMode": "none"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Latency percentiles by route",
      "description": "p50, p95 and p99 response time per route over the whole selected time range. Routes with no requests in the range are left out.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.5, sum by (le, route) (increase(portfolio_http_request_duration_seconds_bucket{route=~\"$route\", route!=\"/api/v1/health/live\"}[$__range]))) > 0",
          "legendFormat": "",
          "refId": "A",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, route) (increase(portfolio_http_request_duration_seconds_bucket{route=~\"$route\", route!=\"/api/v1/health/live\"}[$__range]))) > 0",
          "legendFormat": "",
          "refId": "B",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum by (le, route) (increase(portfolio_http_request_duration_seconds_bucket{route=~\"$route\", route!=\"/api/v1/health/live\"}[$__range]))) > 0",
          "legendFormat": "",
          "refId": "C",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#3987e5"
          },
          "unit": "s",
          "decimals": 3,
          "noValue": "No requests in this time range",
          "custom": {
            "align": "left",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Route"
            },
            "properties": [
              {
                "id": "unit",
                "value": "string"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "p95",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "route",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "route 1": true,
              "route 2": true,
              "route 3": true
            },
            "renameByName": {
              "route": "Route",
              "Value #A": "p50",
              "Value #B": "p95",
              "Value #C": "p99"
            }
          }
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Cache hit rate by endpoint",
      "description": "Share of reads served from Redis, per cached endpoint.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (endpoint) (rate(portfolio_cache_hits_total[$__rate_interval])) / (sum by (endpoint) (rate(portfolio_cache_hits_total[$__rate_interval])) + sum by (endpoint) (rate(portfolio_cache_misses_total[$__rate_interval])))",
          "legendFormat": "{{endpoint}}",
          "refId": "A",
          "format": "time_series"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "percentunit",
          "noValue": "No cached reads in this time range",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "auto",
            "axisLabel": "Hit rate",
            "axisSoftMin": 0,
            "stacking": {
              "mode": "none"
            },
            "spanNulls": false,
            "gradientMode": "none",
            "axisSoftMax": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Database connections",
      "description": "Connections in the API's pool, in use and idle, against the pool's limit (dashed).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (state) (portfolio_db_pool_connections)",
          "legendFormat": "{{state}}",
          "refId": "A",
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max(portfolio_db_pool_max_connections)",
          "legendFormat": "limit",
          "refId": "B",
          "format": "time_series"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short",
          "noValue": "No pool data in this time range",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "auto",
            "axisLabel": "Connections",
            "axisSoftMin": 0,
            "stacking": {
              "mode": "normal"
            },
            "spanNulls": false,
            "gradientMode": "none"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "limit"
            },
            "properties": [
              {
                "id": "custom.stacking",
                "value": {
                  "mode": "none"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    8,
                    6
                  ]
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 1
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#8b8a82"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "in_use"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3987e5"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "idle"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#9a9990"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 11,
      "type": "logs",
      "title": "Recent error logs",
      "description": "Log lines at level error or critical, from every container that writes JSON logs. Click a line to see its fields; a trace_id links to the trace.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "{service=~\".+\"} | json | level=~\"error|critical\"",
          "queryType": "range",
          "refId": "A",
          "maxLines": 100
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 10
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "No error logs in this time range"
        },
        "overrides": []
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending",
        "enableInfiniteScrolling": false
      }
    }
  ]
}
