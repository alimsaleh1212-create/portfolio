// The one collector. It does two jobs:
//   1. Ships the logs of this Compose project's containers to Loki.
//   2. Receives the API's traces (OTLP over HTTP) and forwards them to Tempo.
// Container logs are read through the Docker API, which Alloy reaches only
// through docker-proxy: a filter that allows listing and reading containers
// and nothing that changes them.

discovery.docker "containers" {
  host = "tcp://docker-proxy:2375"

  // Only this project's containers, never others on the same host.
  filter {
    name   = "label"
    values = ["com.docker.compose.project=" + sys.env("COMPOSE_PROJECT")]
  }
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  // The Compose service name (api, caddy, postgres, ...) is the only label.
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
}

loki.source.docker "containers" {
  host          = "tcp://docker-proxy:2375"
  targets       = discovery.docker.containers.targets
  relabel_rules = discovery.relabel.containers.rules
  forward_to    = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

otelcol.receiver.otlp "api" {
  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    traces = [otelcol.processor.batch.default.input]
  }
}

otelcol.processor.batch "default" {
  output {
    traces = [otelcol.exporter.otlp.tempo.input]
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"

    tls {
      insecure = true
    }
  }
}
