# Source documents hold personal contact details; keep them local. The folder
# itself is tracked (through an empty .gitkeep) so a fresh clone has it and
# Docker does not create it as root when it is bind-mounted.
my_docs/*
!my_docs/.gitkeep

# Git worktrees
.worktrees/

# Environment and secrets
.env
.env.*
!.env.example
*.pem
*.key

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.pyright/
.coverage
htmlcov/

# Node
node_modules/
dist/
dist-prerender/
frontend/prerendered/
*.tsbuildinfo
coverage/
npm-debug.log*

# Editors and OS
.idea/
.vscode/
*.swp
.DS_Store

# Playwright
frontend/test-results/
frontend/playwright-report/
