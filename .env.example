# Copy to .env (git-ignored) before running Compose. Values are safe local
# defaults; change them for anything that is not your own machine.

# Host port Caddy listens on. Caddy is the only service published on the host.
CADDY_PORT=8080

# Postgres. The API's DATABASE_URL is built from these in compose.yaml.
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=portfolio-local-password
POSTGRES_DB=portfolio

# MinIO. Used as the root credentials and by the API as its access key.
# The bucket is created at startup.
MINIO_ACCESS_KEY=portfolio-local-access
MINIO_SECRET_KEY=portfolio-local-secret-key
MINIO_BUCKET=portfolio-media

# Folder with the source media (portrait, video, CV PDF), mounted read-only into
# the seed. Defaults to ./my_docs; it must exist, or Docker creates it as root.
# MEDIA_DIR=./my_docs

# The site's public address, with no trailing slash. It is used for canonical addresses, the
# sitemap and the absolute addresses of preview images, which the pre-render writes into the
# pages. Defaults to http://localhost:<CADDY_PORT>. Set it to the real address when deploying,
# then run `docker compose run --rm prerender` (or restart the stack) to rewrite the pages.
# SITE_URL=http://localhost:8080

# API
LOG_LEVEL=INFO
# Per-dependency timeout for /api/v1/health/ready, in seconds.
HEALTH_CHECK_TIMEOUT_SECONDS=2

# Response cache. Entries expire after CACHE_TTL_SECONDS as a safety net (the seed
# invalidates them). A cache read or write that takes longer than
# CACHE_TIMEOUT_SECONDS is abandoned and the request answered from Postgres, and
# after a failure the cache is skipped for CACHE_RETRY_SECONDS.
# CACHE_TTL_SECONDS=3600
# CACHE_TIMEOUT_SECONDS=0.25
# CACHE_RETRY_SECONDS=5
# Port of the API's metrics endpoint, inside the Compose network only. 0 turns it off.
# METRICS_PORT=9100

# Contact messages are always stored. They are also emailed to Ali when SMTP_HOST,
# MAIL_SENDER and MAIL_RECIPIENT are all set; with any of them missing, nothing is
# sent. Delivery is one attempt, so a mail failure never fails the visitor's request
# or loses the stored message.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# starttls (upgrade a plain connection, usually port 587), tls (encrypted from the
# start, usually port 465) or none (plain text; a local catcher only).
# SMTP_SECURITY=starttls
# MAIL_SENDER=portfolio@example.com
# MAIL_RECIPIENT=ali@example.com
# Messages accepted per client per hour; beyond that the API answers 429.
# CONTACT_LIMIT_PER_HOUR=3

# Observability profile (optional): Prometheus, Loki, Tempo, a collector and
# Grafana. Off by default; with it off no extra container runs and the API
# exports nothing. To turn it on, uncomment all four lines below and run
#   docker compose --profile observability up -d --build --wait
# then open http://localhost:3000 (GRAFANA_PORT). Grafana is bound to localhost.
# There is no default password: the profile refuses to start without both.
# Keep them free of quotes and spaces. The admin password only takes effect the
# first time Grafana creates its database (see the README to change it later).
# COMPOSE_PROFILES=observability
# OTEL_EXPORTER_OTLP_ENDPOINT=http://collector:4318
# GRAFANA_ADMIN_PASSWORD=
# GRAFANA_DB_PASSWORD=
# GRAFANA_ADMIN_USER=admin
# GRAFANA_PORT=3000
# Postgres role Grafana reads with (SELECT only); created by the profile.
# GRAFANA_DB_USER=grafana_reader
